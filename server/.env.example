# Anthropic key for the agent. Server-side only — never expose this to the browser.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Langfuse (optional; tracing is skipped when these are unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
